generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Interpreter {
  id             String        @id @default(uuid())
  email          String        @unique
  name           String
  password       String
  receiveEmail   Boolean
  coordinatorsId String?
  createdAt      DateTime      @default(now())
  Coordinators   Coordinators? @relation(fields: [coordinatorsId], references: [id])
  requests       Requests[]
}

model Requests {
  id                String        @id @default(uuid())
  student_name      String
  student_email     String
  name_of_event     String
  time_of_event     String
  location_of_event String
  date              String
  eventDateTime     DateTime
  status            RequestStatus @default(PENDING)
  interpreterId     String?
  Interpreter       Interpreter?  @relation(fields: [interpreterId], references: [id])
  createdAt         DateTime      @default(now())
  acceptedAt        DateTime
}

model Registrationcode {
  id        String   @id @default(uuid())
  email     String
  code      String   @unique
  profile   UserType
  createdAt DateTime @default(now())
}

model Coordinators {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  adminId      String?
  Admin        Admin?        @relation(fields: [adminId], references: [id])
  receiveEmail Boolean
  interpreters Interpreter[]
}

model Admin {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  coordinators Coordinators[]
}

model Invites {
  id        String   @id @default(uuid())
  email     String   @unique
  token     String   @unique
  expiresAt DateTime @default(now())
  used      Boolean  @default(false)
}

model Refreshtoken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @unique
  userType  UserType
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum RequestStatus {
  PENDING
  ACCEPTED
  COMPLETED
}

enum UserType {
  Interpreter
  Coordinators
  Admin
}
