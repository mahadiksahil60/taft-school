// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Interpreter {
  id             Int           @id @default(autoincrement())
  email          String        @unique
  name           String
  password       String
  requests       Requests[]
  Coordinators   Coordinators? @relation(fields: [coordinatorsId], references: [id])
  coordinatorsId Int?
  createdAt      DateTime      @default(now())
}

model Requests {
  id                Int           @id @default(autoincrement())
  student_name      String
  student_email     String        @unique
  name_of_event     String
  time_of_event     String
  location_of_event String
  date              String
  status            RequestStatus @default(PENDING)
  Interpreter       Interpreter?  @relation(fields: [interpreterId], references: [id])
  interpreterId     Int?
}

enum RequestStatus {
  PENDING
  ACCEPTED
  COMPLETED
}

model Coordinators {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  password     String
  interpreters Interpreter[]
  Admin        Admin?        @relation(fields: [adminId], references: [id])
  adminId      Int?
}

model Admin {
  id           Int            @id @default(autoincrement())
  name         String
  email        String         @unique
  coordinators Coordinators[]
}

model Invites {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  token     String   @unique
  expiresAt DateTime @default(now())
  used      Boolean  @default(false)
}
